# Pooled Neon connection string (app runtime queries)
DATABASE_URL=

# Direct (non-pooled) Neon connection string (drizzle-kit migrations need this)
DIRECT_URL=

# Base URL of the FastAPI LLM backend (server-only; tunnel/LAN URL for remote machines)
LLM_BACKEND_URL=

# Shared secret sent to the backend in the X-API-Key header (server-only)
LLM_BACKEND_API_KEY=

# "true" = use the deterministic in-app mock backend (develop without the LLM); "false" = call the real backend
USE_MOCK_BACKEND=true

# Public URL of this app (absolute links, metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000
